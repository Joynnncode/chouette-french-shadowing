# --- Database (Postgres, e.g. Neon via Vercel Marketplace) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: http://localhost:3100/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth app (https://console.cloud.google.com/apis/credentials)
# Callback URL: http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Note: the AI conversation practice feature is "bring your own API key" —
# each user pastes their own Anthropic/OpenAI key in the app UI, stored only
# in their browser (localStorage). No AI provider key is needed server-side.
